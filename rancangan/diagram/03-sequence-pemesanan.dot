  node [shape=box, style="rounded,filled", fillcolor="#f8f3e8", color="#c79a45", fontname="Arial"];
  edge [fontname="Arial", fontsize=9, color="#22384f"];
  customer [label="Pelanggan"];
  web [label="Website"];
  db [label="Database MySQL"];
  admin [label="Admin"];
  customer -> web [label="Pilih paket & isi pemesanan"];
